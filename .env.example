# 온라인 대전용 설정.
# 개발 서버(pnpm run dev)에서는 둘 다 비워 두어도 로컬 서버(ws://localhost:58970/ws)와 stub 로그인으로 동작한다.
# 서버 웹소켓 주소(예: wss://서버주소/ws, 로컬 서버를 다른 주소로 열면 ws://컴퓨터주소:58970/ws).
# 값을 주면 그 출처가 페이지의 보안 정책(CSP) 연결 허용에 자동으로 더해진다(vite.config.ts).
VITE_SERVER_URL=

# 구글 로그인용 OAuth 클라이언트 아이디. 비어 있으면 개발 서버에서만 stub 로그인을 쓴다.
VITE_GOOGLE_CLIENT_ID=
