# 이미지는 레지스트리 없이 deploy.yml이 이 컴퓨터에서 빌드해 서버로 직접 올린다. 태그는 배포 시각(UTC)이다.
server_image: forest-clash-server
server_container_name: forest-clash-server
# 컨테이너 포트를 호스트에 같은 번호로 내보낸다. 바깥의 nginx가 게임서버:58970으로 연결한다.
server_host_port: 58970
server_container_port: 58970

# 컨테이너가 붙는 Docker 네트워크.
docker_network_name: forest-clash

# 승패 기록 폴더. 컨테이너의 /data에 연결되며 컨테이너를 지워도 남는다. 소유자는 이미지의 forestclash 사용자(uid 10001)다.
server_data_path: /root/data/forest-clash
server_data_owner_uid: 10001

# 서버 컨테이너에 넘기는 환경변수.
# AUTH_STUB는 넣지 않는다. 켜면 누구나 아무 이름으로 로그인할 수 있다.
server_env:
  GOOGLE_CLIENT_ID: ""
  # 웹소켓을 열 수 있는 출처. 게임을 여는 주소(예: https://game.example)와 같아야 한다.
  ALLOWED_ORIGIN: ""
